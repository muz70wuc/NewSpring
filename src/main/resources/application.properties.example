spring.application.name=basics

# PostgreSQL Verbindung
spring.datasource.url=jdbc:postgresql://localhost:5432/deine_datenbank_name
spring.datasource.username=postgres
spring.datasource.password=dein_passwort
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate Einstellungen
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# loggin timeout 15 minutes
server.servlet.session.timeout=15m

# Sagt Spring Boot, dass es Proxy-Header wie CF-Connecting-IP oder X-Forwarded-For verarbeiten darf
server.forward-headers-strategy=native


# E-Mail-Versand (IONOS / online.de)
spring.mail.host=smtp.ionos.de
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Zieladresse für B2B-Anfragen
app.mail.target-address=${MAIL_TARGET}